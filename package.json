{
  "name": "chapman-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "gen:seed": "tsx scripts/build-demo-seed.ts",
    "gen:bootstrap": "node scripts/gen-bootstrap.mjs",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "db:seed": "tsx scripts/load-seed.ts",
    "typecheck": "tsc --noEmit",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  }
}
