# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — no NEXT_PUBLIC_ prefix, so Next.js never ships these to the
# browser. Used by scripts/import-seed.ts, scripts/invite-user.ts, and
# scripts/create-chapter-logins.ts (bypasses RLS for setup tasks) AND by
# app/admin/reviewers/actions.ts's in-app "Create Reviewer Account" form
# (bypasses RLS to send invite emails). Must be set in Vercel too, not just
# locally, for that in-app feature to work — never expose it to the browser
# or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
